# Default .gitignore by Gemini
# Betriebssystem-Dateien
.DS_Store
Thumbs.db
desktop.ini

# Editoren & IDEs
.vscode/
.idea/
*.swp
*.swo

# Umgebungsvariablen & Geheimnisse (Wichtig!)
.env
.env.local
*.pem
*.key

# Logs & temporäre Dateien
*.log
npm-debug.log*
yarn-debug.log*
tmp/
temp/

# Abhängigkeiten & Build-Ausgaben (Beispiele)
node_modules/
dist/
build/
__pycache__/
*.pyc
